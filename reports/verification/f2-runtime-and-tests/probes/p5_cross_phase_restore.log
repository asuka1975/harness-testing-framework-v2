  transitions: ['next', 'next', 'rollback_across_phase', 'next', 'next', 'subworkflow_aggregate', 'next']
  gates      : ['prepare:passed', 'prepare:invalidated', 'prepare:passed', 'verify:passed']
  edge_counts: {('verify', 'checks_failed'): 1}
  resolutions: []
